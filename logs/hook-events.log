{"hookName":"permissionRequest","sessionId":"8fac0491-4ac5-4c42-8721-b13ba1dda7a0","timestamp":1786198647970,"cwd":"c:\\kanba\\ai\\projects\\BaseProjectSpace.worktrees\\monthly-yearly-income-expense-visualization","toolName":"edit","toolInput":{"file_path":"c:\\kanba\\ai\\projects\\BaseProjectSpace.worktrees\\monthly-yearly-income-expense-visualization\\SCRIPTS\\analyze_balance.py","diff":"\ndiff --git a/c:/kanba/ai/projects/BaseProjectSpace.worktrees/monthly-yearly-income-expense-visualization/SCRIPTS/analyze_balance.py b/c:/kanba/ai/projects/BaseProjectSpace.worktrees/monthly-yearly-income-expense-visualization/SCRIPTS/analyze_balance.py\ncreate file mode 100644\nindex 0000000..0000000\n--- a/dev/null\n+++ b/c:/kanba/ai/projects/BaseProjectSpace.worktrees/monthly-yearly-income-expense-visualization/SCRIPTS/analyze_balance.py\n@@ -1,0 +1,167 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"谿矩ｫ倥ョ繝ｼ繧ｿ縺九ｉ譛域ｬ｡繝ｻ蟷ｴ谺｡縺ｮ蜿主・(蠅怜刈)繝ｻ謾ｯ蜃ｺ(貂帛ｰ・繧帝寔險医・蝗ｳ遉ｺ縺励∝ｰ・擂繧剃ｺ域ｸｬ縺吶ｋ繧ｹ繧ｯ繝ｪ繝励ヨ縲・n+\n+蜈･蜉・ money/data.txt (繧ｿ繝門玄蛻・ｊ: 譌･莉・ 縺悶ｓ縺縺・\n+蜃ｺ蜉・ money/output/ 驟堺ｸ九↓PNG繧ｰ繝ｩ繝輔→繧ｵ繝槭ΜCSV\n+\"\"\"\n+import os\n+import sys\n+\n+import numpy as np\n+import pandas as pd\n+import matplotlib\n+matplotlib.use(\"Agg\")\n+import matplotlib.pyplot as plt\n+from matplotlib.ticker import FuncFormatter\n+\n+# 譌･譛ｬ隱槭ヵ繧ｩ繝ｳ繝郁ｨｭ螳・Windows諠ｳ螳・\n+for font in [\"Yu Gothic\", \"Meiryo\", \"MS Gothic\"]:\n+    try:\n+        matplotlib.rcParams[\"font.family\"] = font\n+        break\n+    except Exception:\n+        continue\n+matplotlib.rcParams[\"axes.unicode_minus\"] = False\n+\n+BASE = os.path.abspath(os.path.join(os.path.dirname(__file__), \"..\"))\n+DATA_PATH = os.path.join(BASE, \"money\", \"data.txt\")\n+if not os.path.exists(DATA_PATH):\n+    # worktree 縺ｫ data.txt 縺檎┌縺・ｴ蜷医・譛ｬ菴薙・繝ｭ繧ｸ繧ｧ繧ｯ繝医ｒ蜿ら・\n+    alt = r\"c:\\kanba\\ai\\projects\\BaseProjectSpace\\money\\data.txt\"\n+    if os.path.exists(alt):\n+        DATA_PATH = alt\n+OUT_DIR = os.path.join(BASE, \"money\", \"output\")\n+os.makedirs(OUT_DIR, exist_ok=True)\n+\n+# ---------- 繝・・繧ｿ隱ｭ縺ｿ霎ｼ縺ｿ ----------\n+df = pd.read_csv(DATA_PATH, sep=\"\\t\", header=0, names=[\"date\", \"balance\"])\n+df[\"date\"] = pd.to_datetime(df[\"date\"], format=\"%Y/%m/%d %H:%M\")\n+df = df.dropna().sort_values(\"date\").reset_index(drop=True)\n+\n+yen_fmt = FuncFormatter(lambda v, _: f\"{v/10000:,.0f}荳Ⅸ")\n+\n+# ---------- 譛域ｬ｡髮・ｨ・(蜷・怦縺ｮ譛邨よｮ矩ｫ・-> 蜑肴怦蟾ｮ蛻・ ----------\n+monthly = df.set_index(\"date\")[\"balance\"].resample(\"ME\").last().dropna()\n+monthly_diff = monthly.diff().dropna()\n+m_income = monthly_diff.clip(lower=0)   # 蠅怜刈蛻・= 邏泌庶蜈･\n+m_expense = (-monthly_diff).clip(lower=0)  # 貂帛ｰ大・ = 邏疲髪蜃ｺ\n+\n+# ---------- 蟷ｴ谺｡髮・ｨ・----------\n+yearly = df.set_index(\"date\")[\"balance\"].resample(\"YE\").last().dropna()\n+yearly_diff = yearly.diff().dropna()\n+y_income = yearly_diff.clip(lower=0)\n+y_expense = (-yearly_diff).clip(lower=0)\n+\n+# ---------- 蝗ｳ1: 谿矩ｫ俶耳遘ｻ ----------\n+fig, ax = plt.subplots(figsize=(14, 6))\n+ax.plot(df[\"date\"], df[\"balance\"], color=\"#1f77b4\", lw=1.5)\n+ax.fill_between(df[\"date\"], df[\"balance\"], alpha=0.15, color=\"#1f77b4\")\n+ax.set_title(\"谿矩ｫ俶耳遘ｻ (2003-2026)\", fontsize=14)\n+ax.set_ylabel(\"谿矩ｫ・(蜀・\")\n+ax.yaxis.set_major_formatter(yen_fmt)\n+ax.grid(alpha=0.3)\n+fig.tight_layout()\n+fig.savefig(os.path.join(OUT_DIR, \"01_balance_trend.png\"), dpi=120)\n+plt.close(fig)\n+\n+# ---------- 蝗ｳ2: 譛域ｬ｡ 蠅怜刈(蜿主・)/貂帛ｰ・謾ｯ蜃ｺ) ----------\n+fig, ax = plt.subplots(figsize=(14, 6))\n+ax.bar(m_income.index, m_income.values, width=20, color=\"#2ca02c\", label=\"蠅怜刈(邏泌庶蜈･)\")\n+ax.bar(m_expense.index, -m_expense.values, width=20, color=\"#d62728\", label=\"貂帛ｰ・邏疲髪蜃ｺ)\")\n+ax.axhline(0, color=\"black\", lw=0.8)\n+ax.set_title(\"譛域ｬ｡縺ｮ谿矩ｫ伜｢玲ｸ・(蠅怜刈=邏泌庶蜈･ / 貂帛ｰ・邏疲髪蜃ｺ)\", fontsize=14)\n+ax.set_ylabel(\"蠅玲ｸ幃｡・(蜀・\")\n+ax.yaxis.set_major_formatter(yen_fmt)\n+ax.legend()\n+ax.grid(alpha=0.3)\n+fig.tight_layout()\n+fig.savefig(os.path.join(OUT_DIR, \"02_monthly_income_expense.png\"), dpi=120)\n+plt.close(fig)\n+\n+# ---------- 蝗ｳ3: 蟷ｴ谺｡ 蠅怜刈/貂帛ｰ・縺ｨ 邏泌｢・----------\n+years = yearly_diff.index.year\n+fig, ax = plt.subplots(figsize=(14, 6))\n+ax.bar(years - 0.2, y_income.values, width=0.4, color=\"#2ca02c\", label=\"蠅怜刈(邏泌庶蜈･)\")\n+ax.bar(years + 0.2, -y_expense.values, width=0.4, color=\"#d62728\", label=\"貂帛ｰ・邏疲髪蜃ｺ)\")\n+ax.plot(years, yearly_diff.values, color=\"#1f77b4\", marker=\"o\", lw=1.5, label=\"蟷ｴ髢鍋ｴ泌｢鈴｡構")\n+ax.axhline(0, color=\"black\", lw=0.8)\n+ax.set_title(\"蟷ｴ谺｡縺ｮ谿矩ｫ伜｢玲ｸ媾", fontsize=14)\n+ax.set_ylabel(\"驥鷹｡・(蜀・\")\n+ax.yaxis.set_major_formatter(yen_fmt)\n+ax.set_xticks(years[::2])\n+ax.legend()\n+ax.grid(alpha=0.3)\n+fig.tight_layout()\n+fig.savefig(os.path.join(OUT_DIR, \"03_yearly_income_expense.png\"), dpi=120)\n+plt.close(fig)\n+\n+# ---------- 莠域ｸｬ ----------\n+# 繝・・繧ｿ縺悟ｮ悟・縺ｪ譛滄俣(2008蟷ｴ莉･髯・縺ｧ蝗槫ｸｰ縲りｿ大ｹｴ縺ｮ蛯ｾ蜷代ｒ驥崎ｦ悶☆繧九◆繧∫峩霑・0蟷ｴ縺ｧ繧ょ屓蟶ｰ縲・n+ts = df.set_index(\"date\")[\"balance\"]\n+t0 = ts.index[0]\n+x_all = np.array([(d - t0).days for d in ts.index], dtype=float)\n+y_all = ts.values.astype(float)\n+\n+def fit_linear(mask):\n+    coef = np.polyfit(x_all[mask], y_all[mask], 1)\n+    return coef  # (slope per day, intercept)\n+\n+mask_recent10 = ts.index >= (ts.index[-1] - pd.DateOffset(years=10))\n+mask_recent5 = ts.index >= (ts.index[-1] - pd.DateOffset(years=5))\n+coef10 = fit_linear(mask_recent10.values)\n+coef5 = fit_linear(mask_recent5.values)\n+\n+# 莠梧ｬ｡蠑・蜈ｨ譛滄俣): 邱ｩ繧・°縺ｪ蜉騾溘ｒ謐峨∴繧欺n+coef_q = np.polyfit(x_all, y_all, 2)\n+\n+future_end = pd.Timestamp(\"2036-12-31\")\n+future_dates = pd.date_range(ts.index[-1], future_end, freq=\"ME\")\n+xf = np.array([(d - t0).days for d in future_dates], dtype=float)\n+\n+pred10 = np.polyval(coef10, xf)\n+pred5 = np.polyval(coef5, xf)\n+pred_q = np.polyval(coef_q, xf)\n+\n+fig, ax = plt.subplots(figsize=(14, 6))\n+ax.plot(ts.index, y_all, color=\"#1f77b4\", lw=1.5, label=\"螳溽ｸｾ\")\n+ax.plot(future_dates, pred5, \"--\", color=\"#2ca02c\", label=f\"逶ｴ霑・蟷ｴ邱壼ｽ｢ (+{coef5[0]*365.25/10000:,.0f}荳・・/蟷ｴ)\")\n+ax.plot(future_dates, pred10, \"--\", color=\"#ff7f0e\", label=f\"逶ｴ霑・0蟷ｴ邱壼ｽ｢ (+{coef10[0]*365.25/10000:,.0f}荳・・/蟷ｴ)\")\n+ax.plot(future_dates, pred_q, \"--\", color=\"#9467bd\", label=\"蜈ｨ譛滄俣莠梧ｬ｡霑台ｼｼ(蜉騾溷だ蜷・\")\n+ax.set_title(\"谿矩ｫ倥・蟆・擂莠域ｸｬ (~2036蟷ｴ)\", fontsize=14)\n+ax.set_ylabel(\"谿矩ｫ・(蜀・\")\n+ax.yaxis.set_major_formatter(yen_fmt)\n+ax.legend()\n+ax.grid(alpha=0.3)\n+fig.tight_layout()\n+fig.savefig(os.path.join(OUT_DIR, \"04_forecast.png\"), dpi=120)\n+plt.close(fig)\n+\n+# ---------- 繧ｵ繝槭Μ蜃ｺ蜉・----------\n+summary = pd.DataFrame({\n+    \"蟷ｴ譛ｫ谿矩ｫ禄": yearly.values,\n+}, index=yearly.index.year)\n+summary[\"蟷ｴ髢鍋ｴ泌｢予"] = summary[\"蟷ｴ譛ｫ谿矩ｫ禄"].diff()\n+summary.to_csv(os.path.join(OUT_DIR, \"yearly_summary.csv\"), encoding=\"utf-8-sig\")\n+\n+md = pd.DataFrame({\"譛域忰谿矩ｫ禄": monthly, \"蜑肴怦豈泌｢玲ｸ媾": monthly.diff()})\n+md.to_csv(os.path.join(OUT_DIR, \"monthly_summary.csv\"), encoding=\"utf-8-sig\")\n+\n+# 繧ｳ繝ｳ繧ｽ繝ｼ繝ｫ繧ｵ繝槭Μ\n+print(\"=== 蟷ｴ谺｡繧ｵ繝槭Μ (逶ｴ霑・0蟷ｴ) ===\")\n+print(summary.tail(10).to_string())\n+print()\n+recent5_annual = coef5[0] * 365.25\n+recent10_annual = coef10[0] * 365.25\n+print(f\"逶ｴ霑・蟷ｴ縺ｮ蠅怜刈繝壹・繧ｹ : 邏・{recent5_annual/10000:,.0f} 荳・・/蟷ｴ (邏・{recent5_annual/12/10000:,.1f} 荳・・/譛・\")\n+print(f\"逶ｴ霑・0蟷ｴ縺ｮ蠅怜刈繝壹・繧ｹ: 邏・{recent10_annual/10000:,.0f} 荳・・/蟷ｴ (邏・{recent10_annual/12/10000:,.1f} 荳・・/譛・\")\n+print()\n+for target_year in [2027, 2030, 2033, 2036]:\n+    d = pd.Timestamp(f\"{target_year}-12-31\")\n+    xd = (d - t0).days\n+    p5 = np.polyval(coef5, xd)\n+    p10 = np.polyval(coef10, xd)\n+    pq = np.polyval(coef_q, xd)\n+    print(f\"{target_year}蟷ｴ譛ｫ莠域ｸｬ: 5蟷ｴ邱壼ｽ｢ {p5/10000:,.0f}荳・・ / 10蟷ｴ邱壼ｽ｢ {p10/10000:,.0f}荳・・ / 莠梧ｬ｡霑台ｼｼ {pq/10000:,.0f}荳・・\")\n+\n+print()\n+print(f\"蜃ｺ蜉帛・: {OUT_DIR}\")\n"},"permissionSuggestions":[]}


