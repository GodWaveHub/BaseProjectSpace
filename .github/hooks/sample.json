{
	"version": 1,
	"hooks": {
		"sessionStart": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"sessionEnd": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"userPromptSubmitted": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"preToolUse": [
			{
				"matcher": "Agent",
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"postToolUse": [
			{
				"matcher": "Agent",
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"postToolUseFailure": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"agentStop": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"subagentStart": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"subagentStop": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"errorOccurred": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"preCompact": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"notification": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		],
		"permissionRequest": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1",
				"bash": "bash ./SCRIPTS/log-subagent-hook.sh"
			}
		]
	}
}