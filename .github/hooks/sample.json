{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Agent",
				"hooks": [
					{
						"type": "command",
						"command": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Agent",
				"hooks": [
					{
						"type": "command",
						"command": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1"
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1"
					}
				]
			}
		],
		"SubagentStop": [
			// サブエージェント終了時に結果サマリーをログ
			{
				"hooks": [
					{
						"type": "command",
						"command": "pwsh -NoProfile -File ./SCRIPTS/log-subagent-hook.ps1"
					}
				]
			}
		]
	}
}