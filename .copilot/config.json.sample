{
  "model": "claude-opus-4.6",
  "theme": "auto",
  "stream": true,
  "alt_screen": false,
  "auto_update": true,
  "banner": "never",
  "beep": true,
  "include_coauthor": true,
  "compact_paste": true,
  "custom_agents": {
    "default_local_only": false
  },
  "experimental": false,
  "log_level": "all",
  "render_markdown": true,
  "screen_reader": false,
  "streamer_mode": false,
  "parallel_tool_execution": true,
  "update_terminal_title": true,
  "undo_without_confirmation": false,
  "launch_messages": [
    "おはようございます！今日も頑張りましょう！",
    "コーディングを楽しみましょう！"
  ],
  "allowed_urls": [
    "*"
  ],
  "denied_urls": [],
  "trusted_folders": [],
